class Solution {
    public int countPrimes(int n) {
        if (n <= 2){
            return 0;
        }

        boolean[] b = new boolean[(n - 2) / 2];
        int c = 1;

        for (int i = 0; (2 * i + 3) * (2 * i + 3) < n; i++) {
            if (!b[i]) {
                int p = 2 * i + 3;

                for (int j = (p * p - 3) / 2; j < b.length; j += p){
                    b[j] = true;}
            }
        }

        for (int i = 0; i < b.length; i++) {
            if (!b[i])
                c++;
        }

        return c;
    }
}
